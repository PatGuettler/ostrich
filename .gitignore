# Godot editor caches for every game project
**/.godot/
.nomedia
**/.import/

# Build outputs
**/builds/
*.apk
*.aab
export.cfg
export_credentials.cfg

# Play Console artwork is not loaded by the game. Godot may scan it during an
# editor/export run, but its generated import sidecars do not belong in source.
**/store/google-play/**/*.import

# Generated per-game Godot Android build templates. Each game's release
# overlays and version marker remain normal tracked source files.
**/android/build/
**/android/.gradle/

# Runtime configuration and credentials
**/config/admob.json
*.keystore
*.jks
*service-account*.json

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local tooling and OS files
.local-cache/
*.tmp
*.log
.DS_Store
