# Godot editor cache
.godot/
.nomedia
.import/

# Build outputs
builds/
*.apk
*.aab
export.cfg
export_credentials.cfg

# Play Console artwork is not loaded by the game. Godot may scan it during an
# editor/export run, but its generated import sidecars do not belong in source.
store/google-play/**/*.import

# Generated Godot Android build template. Keep only the release overlays.
/android/*
!android/.build_version
!android/play-release.gradle
!android/proguard-godot-play.pro

# Runtime configuration and credentials
config/admob.json
*.keystore
*.jks
*service-account*.json

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local tooling and OS files
.local-cache/
*.tmp
*.log
.DS_Store
